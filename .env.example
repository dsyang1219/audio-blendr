# ---------------------------------------------------------------------------
# Audio Blendr — environment variables
#
# Copy to `.env` for local development. `.env` is git-ignored.
# In production (Cloudflare Workers) set these as Worker secrets / vars.
#
# VITE_* variables are inlined into the browser bundle at build time and are
# therefore PUBLIC. Everything else is server-only.
# ---------------------------------------------------------------------------

# --- Supabase (https://supabase.com/dashboard/project/_/settings/api) -------
# Public: safe to expose, protected by row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Same values, read by server code (server functions, middleware).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# SECRET. Bypasses RLS. Used only by /api/spotify/callback to persist tokens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Spotify (https://developer.spotify.com/dashboard) ----------------------
SPOTIFY_CLIENT_ID=your-spotify-client-id
# SECRET.
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Public origin of this deployment. The OAuth redirect URI registered in the
# Spotify dashboard must be exactly `${SPOTIFY_APP_ORIGIN}/api/spotify/callback`.
SPOTIFY_APP_ORIGIN=http://localhost:8080
# Optional, comma-separated. Extra origins the callback may redirect back to
# (preview deployments, a second local port). The app origin is always allowed.
SPOTIFY_ALLOWED_RETURN_ORIGINS=
# Optional SECRET used to HMAC-sign the OAuth `state` parameter. Falls back to
# SPOTIFY_CLIENT_SECRET when unset. Generate one with: openssl rand -hex 32
SPOTIFY_STATE_SECRET=

# --- YouTube Data API v3 (https://console.cloud.google.com/apis/credentials) -
# SECRET. Each search.list call costs 100 of the 10,000 daily quota units.
YOUTUBE_API_KEY=your-youtube-api-key

# --- Site ---------------------------------------------------------------------
# Public. Shown on the Privacy Policy and Terms pages.
VITE_CONTACT_EMAIL=you@example.com
